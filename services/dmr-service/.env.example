# DMR Service Configuration

# Flask
FLASK_ENV=development
FLASK_DEBUG=False

# Port
PORT=5000

# Logging
LOG_LEVEL=INFO

# Security - API Key Authentication
# Set a strong, random API key for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DMR_API_KEY=your-secret-api-key-here-min-32-chars-recommended

# Enable/disable API key authentication
# Set to 'false' to disable auth (useful for development/debugging)
DMR_REQUIRE_AUTH=true
