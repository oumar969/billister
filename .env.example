# Docker Compose Environment Variables
# Copy this file to .env and set your own values
# Never commit .env to git!

# ============================================
# DMR Service (Python Flask)
# ============================================

# API Key for authenticating calls to the DMR service
# Must match the key used by the .NET backend
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DMR_API_KEY=your-secret-api-key-here-change-in-production

# Enable/disable API key authentication (true for production)
DMR_REQUIRE_AUTH=true

# Flask environment (development or production)
FLASK_ENV=production
FLASK_DEBUG=false

# ============================================
# .NET Backend (Billister API)
# ============================================

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Production

# Application URLs (http and https ports)
ASPNETCORE_URLS=http://+:5012;https://+:7012

# JWT Secret (should be loaded from Docker secrets in production)
# For docker-compose, use a strong random string
JWT_KEY=change-me-to-a-long-random-string-in-production

# ============================================
# Database (SQLite in this example)
# ============================================

# Connection string is defined in appsettings.json
# For production with Docker, consider using PostgreSQL instead
